<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.human.web_board.dao.PostDao">

    <update id="increaseRecommendationsCount" parameterType="long">
        UPDATE post
        SET recommendations_count = recommendations_count + 1
        WHERE id = #{id}
    </update>

    <select id="getRecommendationsCount" parameterType="long" resultType="int">
        SELECT recommendations_count
        FROM post
        WHERE id = #{id}
    </select>

</mapper>